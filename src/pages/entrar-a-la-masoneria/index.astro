---
import BaseLayout from "@layouts/BaseLayout.astro";
import SiteHeader from "@components/SiteHeader.astro";
import SiteFooter from "@components/SiteFooter.astro";
import OrnamentDivider from "@components/OrnamentDivider.astro";
import MalteseCross from "@components/MalteseCross.astro";
import Circumpunct from "@components/Circumpunct.astro";
import SatelliteNavigation from "@components/SatelliteNavigation.astro";
import ApronIcon from "@components/ApronIcon.astro";
import { absoluteSiteUrl, site } from "../../lib/site";
import sphereMark from "../../../recursos-originales/esfera.svg?url";
import balanceMark from "../../../recursos-originales/libra.svg?url";
import trowelMark from "../../../recursos-originales/tula.svg?url";

const pagePath = "/entrar-a-la-masoneria/";
const pageUrl = absoluteSiteUrl(pagePath);
const pageTitle = "Entrar a la Masonería: requisitos y compromiso";
const pageDescription =
  "Conoce los requisitos para entrar a la Masonería en Heredom, quién puede solicitar acercamiento y qué compromiso exige la Masonería Operativa.";
const approachUrl =
  "https://docs.google.com/forms/d/e/1FAIpQLSfgiDWhsQwmMrca4y43sPNu45gwji_t-iZyJqYz6jEF2abEfA/viewform?usp=dialog";

const faqItems = [
  {
    question: "¿Cuáles son los requisitos para entrar a la Masonería?",
    answer:
      "En Heredom, la candidatura exige ser una persona mayor de edad y acreditarlo mediante documentación oficial vigente; ser libre y de buenas costumbres; estar debidamente cualificada física, psíquica y espiritualmente; conocer y aceptar el sello crístico de la Orden; y poder asumir con constancia las tenidas, el ritual y los trabajos de cada nivel. La solicitud abre un proceso de acercamiento y evaluación, no garantiza la admisión.",
  },
  {
    question: "¿A qué edad se puede entrar a la Masonería?",
    answer:
      "Sólo pueden solicitar acercamiento personas mayores de edad. La mayoría de edad deberá acreditarse mediante documentación oficial vigente durante el proceso; también son indispensables la madurez y la capacidad de sostener el compromiso.",
  },
  {
    question: "¿Las mujeres pueden entrar a la Masonería?",
    answer:
      "Sí. La Orden Real de Heredom de Kilwinning declara que recibe en sus Logias a hombres y mujeres debidamente cualificados, con las adaptaciones necesarias y en igualdad de deberes y derechos.",
  },
  {
    question: "¿Quién puede entrar a la Masonería?",
    answer:
      "Puede solicitar acercamiento una persona mayor de edad, sea hombre o mujer, con una búsqueda iniciática auténtica y capacidad para asumir la disciplina de la Orden. La mayoría de edad deberá acreditarse mediante documentación oficial vigente. La consulta está abierta tanto a quien no posee iniciación previa como a masones procedentes de otras obediencias. Cada candidatura se considera individualmente.",
  },
  {
    question: "¿Qué se necesita para entrar a la Masonería?",
    answer:
      "Se necesita algo más que curiosidad: libertad personal, rectitud de conducta, disposición espiritual, aceptación consciente de la identidad cristiano-templaria de Heredom y compromiso sostenido con la asistencia, el ritual y el trabajo iniciático. Para este Capítulo también se requiere disponibilidad real para participar presencialmente en Querétaro.",
  },
] as const;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      isPartOf: { "@id": `${absoluteSiteUrl("/")}#website` },
      about: { "@id": `${absoluteSiteUrl("/")}#organization` },
      breadcrumb: { "@id": `${pageUrl}#breadcrumb` },
      inLanguage: site.language,
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Inicio",
          item: absoluteSiteUrl("/"),
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Entrar a la Masonería",
          item: pageUrl,
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#preguntas`,
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={pagePath}
  structuredData={structuredData}
>
  <SiteHeader current={pagePath} variant="satellite" />

  <main id="contenido">
    <header class="page-hero">
      <img
        class="hero-art"
        src="/images/entrar-masoneria-grabado-dore.webp"
        alt="Grabado de un aspirante ante el umbral de un taller de canteros, iluminado desde el interior"
        width="1672"
        height="941"
        decoding="async"
        fetchpriority="high"
      />
      <div class="container hero-grid">
        <div class="hero-copy">
          <nav class="breadcrumb" aria-label="Migas de pan">
            <a href="/">Inicio</a><span aria-hidden="true">/</span><span aria-current="page">Acercamiento</span>
          </nav>
          <p class="overline hero-eyebrow">Acercamiento · Heredom México</p>
          <h1>¿Qué se necesita para entrar a la Masonería?</h1>
          <p class="hero-lede">
            Antes de preguntar cómo entrar, conviene comprender qué significa ser masón:
            una vía iniciática que exige trabajo, presencia y un compromiso que no depende
            del ánimo del día.
          </p>
          <p class="hero-principle">Ser masón no es pertenecer. Es trabajar.</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#requisitos">Conocer los requisitos</a>
            <a
              class="btn btn-quiet"
              href={approachUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Solicitar acercamiento mediante el formulario de la Orden (abre en una pestaña nueva)"
            >Solicitar acercamiento</a>
          </div>
          <p class="hero-trust">Conversación reservada · La solicitud no implica admisión</p>
        </div>
      </div>
    </header>

    <section class="meaning section-space" aria-labelledby="meaning-title">
      <div class="container meaning-grid">
        <header class="section-head">
          <div class="meaning-marks" aria-hidden="true">
            <MalteseCross size={42} class="meaning-cross" />
            <span></span>
            <Circumpunct size={34} class="meaning-circumpunct" />
          </div>
          <p class="overline">Antes del ingreso</p>
          <h2 id="meaning-title">¿Qué significa ser masón para Heredom?</h2>
        </header>

        <div class="meaning-copy prose">
          <p class="lead">
            Ser masón es emprender un camino iniciático arduo y, al mismo tiempo,
            gozoso: buscar una guía espiritual, trabajar por el retorno al Padre y
            orientar la existencia hacia la Unidad.
          </p>
          <p>
            Ese camino implica un compromiso de por vida. No consiste en asistir sólo
            cuando hay ánimo, sino en concurrir a las tenidas, practicar el ritual y
            realizar los trabajos correspondientes a cada nivel. Exige compromiso con
            la verdad, con el espíritu y con la unidad.
          </p>
          <p>
            La integridad, los principios y los valores no se usan como distintivos para
            presumir: se demuestran en la conducta y en la continuidad del trabajo.
          </p>
          <blockquote>
            Ser masón es comprometerse con la verdad, con el espíritu y, sobre todo,
            con la unidad.
          </blockquote>
        </div>
      </div>

      <div class="container commitment-axis" aria-label="Ejes del compromiso masónico">
        <div>
          <span class="axis-numeral" aria-hidden="true">I</span>
          <span class="axis-mark" style={`--axis-mask: url("${balanceMark}")`} aria-hidden="true"></span>
          <strong>Verdad</strong>
        </div>
        <div>
          <span class="axis-numeral" aria-hidden="true">II</span>
          <span class="axis-mark" style={`--axis-mask: url("${sphereMark}")`} aria-hidden="true"></span>
          <strong>Espíritu</strong>
        </div>
        <div>
          <span class="axis-numeral" aria-hidden="true">III</span>
          <Circumpunct size={50} class="axis-circumpunct" />
          <strong>Presencia</strong>
        </div>
        <div>
          <span class="axis-numeral" aria-hidden="true">IV</span>
          <span class="axis-mark axis-mark--wide" style={`--axis-mask: url("${trowelMark}")`} aria-hidden="true"></span>
          <strong>Trabajo</strong>
        </div>
      </div>
    </section>

    <section class="not-list" aria-labelledby="not-title">
      <div class="container not-grid">
        <div>
          <p class="overline">Una precisión necesaria</p>
          <h2 id="not-title">Lo que no debe buscarse al entrar</h2>
        </div>
        <ul role="list">
          <li>Una organización para acumular relaciones o prestigio.</li>
          <li>Un peldaño de oportunidad política o ascenso social.</li>
          <li>Una asociación cuya finalidad principal sea la actividad caritativa.</li>
          <li>Una membresía cómoda que pueda atenderse sólo cuando sobra tiempo.</li>
        </ul>
      </div>
    </section>

    <section class="paths section-space" aria-labelledby="paths-title">
      <div class="container">
        <header class="section-head paths-head">
          <p class="overline">Dos puntos de partida</p>
          <h2 id="paths-title">¿Necesito haber sido masón antes?</h2>
          <p>
            No todos llegan con la misma experiencia. El acercamiento permite conocer
            cada caso sin confundir una consulta con una admisión automática.
          </p>
        </header>

        <div class="path-grid">
          <article>
            <p class="path-number" aria-hidden="true">I</p>
            <ApronIcon variant="apprentice" class="path-apron" />
            <h3>Sin iniciación previa</h3>
            <p>
              Una persona que nunca ha pertenecido a una logia puede solicitar
              información si su interés es auténticamente iniciático y comprende la
              disciplina que está considerando asumir.
            </p>
          </article>
          <article>
            <p class="path-number" aria-hidden="true">II</p>
            <ApronIcon variant="templar" class="path-apron" />
            <h3>Desde otra obediencia</h3>
            <p>
              Un masón procedente de la corriente especulativa o de otra obediencia puede
              acercarse para conocer la perspectiva operativa de Heredom. Su experiencia
              previa se escucha, pero no sustituye el proceso propio de la Orden.
            </p>
          </article>
        </div>
      </div>
    </section>

    <OrnamentDivider />

    <section id="requisitos" class="requirements section-space" aria-labelledby="requirements-title">
      <div class="container">
        <header class="section-head requirements-head">
          <p class="overline">Condiciones de acercamiento</p>
          <h2 id="requirements-title">Requisitos para entrar a la Masonería en Heredom</h2>
          <p>
            Los documentos públicos de la Orden y su criterio de formación señalan las
            siguientes condiciones generales. El cumplimiento de esta lista no concede
            por sí mismo el ingreso.
          </p>
        </header>

        <ol class="requirement-grid">
          <li>
            <span aria-hidden="true">01</span>
            <h3>Libertad y conducta</h3>
            <p>
              Ser mayor de edad, acreditarlo mediante documentación oficial vigente,
              y ser una persona libre y de buenas costumbres.
            </p>
          </li>
          <li>
            <span aria-hidden="true">02</span>
            <h3>Cualificación integral</h3>
            <p>Estar debidamente cualificada en los planos físico, psíquico y espiritual.</p>
          </li>
          <li>
            <span aria-hidden="true">03</span>
            <h3>Identidad de la Orden</h3>
            <p>
              Conocer y aceptar su sello crístico y templario. Esto no exige una
              conversión confesional, pero no es compatible con una posición expresamente atea.
            </p>
          </li>
          <li>
            <span aria-hidden="true">04</span>
            <h3>Compromiso sostenido</h3>
            <p>Asumir la asistencia a las tenidas, la práctica ritual y el trabajo por niveles.</p>
          </li>
          <li>
            <span aria-hidden="true">05</span>
            <h3>Presencia real</h3>
            <p>Contar con disponibilidad para participar periódicamente de manera presencial en Querétaro.</p>
          </li>
          <li>
            <span aria-hidden="true">06</span>
            <h3>Proceso individual</h3>
            <p>Participar con honestidad en el acercamiento, el diálogo y la evaluación de la candidatura.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="women" aria-labelledby="women-title">
      <div class="container women-grid">
        <div>
          <p class="overline">Una respuesta inequívoca</p>
          <h2 id="women-title">¿Las mujeres pueden entrar a la Masonería?</h2>
        </div>
        <figure class="women-figure">
          <img
            src="/images/primavera-botticelli-figura-central.webp"
            alt="Figura femenina central de La Primavera de Sandro Botticelli, utilizada como alegoría visual"
            width="234"
            height="348"
            loading="lazy"
            decoding="async"
          />
          <figcaption>Figura central de <cite>La Primavera</cite> · Sandro Botticelli</figcaption>
        </figure>
        <div class="prose women-answer">
          <p class="answer-lead">Sí, en Heredom pueden solicitar acercamiento.</p>
          <p>
            Los <cite>Vetera Instituta et Fundamenta Ordinis</cite> declaran que la Orden
            recibe en sus Logias, con las adaptaciones necesarias, a hombres y mujeres
            debidamente cualificados «en igualdad de deberes y derechos».
          </p>
        </div>
      </div>
    </section>

    <section id="preguntas" class="faq section-space" aria-labelledby="faq-title">
      <div class="container faq-grid">
        <header class="section-head faq-head">
          <p class="overline">Preguntas frecuentes</p>
          <h2 id="faq-title">Antes de solicitar acercamiento</h2>
          <p>
            Respuestas públicas y concretas. Las circunstancias particulares se revisan
            de forma reservada durante el proceso.
          </p>
        </header>

        <div class="faq-list">
          {faqItems.map((item, index) => (
            <details open={index === 0}>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="source-note" aria-labelledby="source-title">
      <div class="prose-width prose">
        <p class="overline">Base de esta orientación</p>
        <h2 id="source-title">Doctrina pública y criterio de formación</h2>
        <p>
          Esta página sintetiza los <cite>Vetera Instituta et Fundamenta Ordinis</cite>,
          los Antiguos Deberes conservados por Heredom y una exposición oral sobre el
          significado y el compromiso de ser masón. No revela rituales ni sustituye la
          conversación personal con la Orden.
        </p>
        <p>
          <a href="/documentos/vetera-instituta-et-fundamenta-ordinis.pdf">Consultar los fundamentos de la Orden (PDF)</a>
        </p>
      </div>
    </section>

    <SatelliteNavigation current={pagePath} />

  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .section-space {
    padding-block: clamp(var(--space-2xl), 8vw, var(--space-3xl));
  }

  .section-head {
    max-width: 45rem;
  }

  .section-head .overline,
  .not-grid .overline,
  .women .overline,
  .source-note .overline {
    color: var(--text-accent-strong);
  }

  .section-head h2,
  .not-grid h2,
  .women h2,
  .source-note h2 {
    margin-block-start: var(--space-xs);
  }

  .section-head > p:last-child {
    margin-block-start: var(--space-m);
    color: var(--text-muted);
  }

  .page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(var(--space-xl), 8vw, var(--space-3xl));
    background: var(--surface-inverse);
    color: var(--text-on-inverse);
    border-bottom: 1px solid var(--line-bronze);
  }

  .page-hero::after {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(9, 29, 24, 0.98) 0%,
        rgba(16, 42, 36, 0.94) 28%,
        rgba(24, 59, 51, 0.82) 48%,
        rgba(16, 42, 36, 0.34) 72%,
        rgba(9, 29, 24, 0.16) 100%
      ),
      linear-gradient(0deg, rgba(9, 29, 24, 0.76) 0%, transparent 48%, rgba(9, 29, 24, 0.3) 100%);
  }

  .hero-art {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-grid {
    min-height: clamp(31rem, 52vw, 43rem);
    display: flex;
    align-items: center;
  }

  .hero-copy {
    width: min(100%, 47rem);
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.38);
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-block-end: var(--space-xl);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: rgba(244, 239, 226, 0.56);
  }

  .breadcrumb a {
    color: rgba(244, 239, 226, 0.72);
  }

  .hero-eyebrow {
    color: #d0b27b;
  }

  .hero-copy h1 {
    color: var(--text-on-inverse);
    max-width: 50rem;
    margin-block-start: var(--space-s);
  }

  .hero-lede {
    margin-block-start: var(--space-l);
    color: rgba(244, 239, 226, 0.8);
    font-size: var(--step-1);
    max-width: 44rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-block-start: var(--space-xl);
  }

  .hero-trust {
    margin-block-start: var(--space-s);
    color: rgba(244, 239, 226, 0.58);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    letter-spacing: 0.025em;
  }

  .hero-principle {
    margin-block-start: var(--space-l);
    padding-inline-start: var(--space-m);
    border-inline-start: 2px solid #d0b27b;
    color: #d0b27b;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: var(--leading-heading);
  }

  .btn-quiet {
    color: var(--text-on-inverse);
    border-color: rgba(208, 178, 123, 0.58);
    background: rgba(16, 42, 36, 0.34);
    backdrop-filter: blur(3px);
  }

  .btn-quiet:hover {
    color: #fffdf5;
    border-color: #d0b27b;
  }

  .meaning-grid {
    display: grid;
    grid-template-columns: minmax(15rem, 0.75fr) minmax(0, 1.25fr);
    gap: var(--space-2xl);
    align-items: start;
  }

  .women-grid {
    display: grid;
    grid-template-columns: minmax(13rem, 0.7fr) minmax(12rem, 0.55fr) minmax(0, 1fr);
    gap: clamp(var(--space-l), 4vw, var(--space-2xl));
    align-items: center;
  }

  .meaning-copy {
    max-width: var(--width-prose);
  }

  .meaning {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--text-on-inverse);
    background: var(--surface-header);
    border-block: 1px solid color-mix(in srgb, var(--accent-bronze) 58%, transparent);
  }

  .meaning::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    opacity: 0.16;
    background-image:
      repeating-linear-gradient(112deg, transparent 0 9px, rgba(244, 239, 226, 0.11) 9px 10px),
      repeating-linear-gradient(68deg, transparent 0 16px, rgba(155, 117, 66, 0.12) 16px 17px);
    pointer-events: none;
  }

  .meaning .section-head .overline {
    color: #d0b27b;
  }

  .meaning .section-head h2,
  .meaning-copy .lead {
    color: var(--text-on-inverse);
  }

  .meaning-copy p {
    color: rgba(244, 239, 226, 0.76);
  }

  .meaning-marks {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    width: min(15rem, 100%);
    margin-block-end: var(--space-l);
    color: #d0b27b;
  }

  .meaning-marks span {
    flex: 1;
    height: 1px;
    background: currentColor;
    opacity: 0.58;
  }

  .meaning-copy blockquote {
    margin: var(--space-xl) 0 0;
    padding: var(--space-m) 0 var(--space-m) var(--space-l);
    border-inline-start: 1px solid #d0b27b;
    color: #f7ecd2;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: var(--leading-heading);
  }

  .commitment-axis {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-block-start: var(--space-2xl);
    border-block: 1px solid rgba(208, 178, 123, 0.44);
  }

  .commitment-axis div {
    display: grid;
    grid-template-rows: auto 4rem auto;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-l) var(--space-m);
    text-align: center;
  }

  .commitment-axis div + div {
    border-inline-start: 1px solid rgba(208, 178, 123, 0.3);
  }

  .axis-numeral {
    color: rgba(208, 178, 123, 0.72);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
  }

  .axis-mark {
    display: block;
    width: 3.35rem;
    height: 3.35rem;
    margin-inline: auto;
    background: #d0b27b;
    -webkit-mask: var(--axis-mask) center / contain no-repeat;
    mask: var(--axis-mask) center / contain no-repeat;
    opacity: 0.82;
  }

  .axis-mark--wide {
    width: 4.5rem;
  }

  .commitment-axis :global(.axis-circumpunct) {
    display: block;
    margin-inline: auto;
    color: #d0b27b;
    opacity: 0.82;
  }

  .commitment-axis strong {
    color: var(--text-on-inverse);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
  }

  .not-list {
    padding-block: var(--space-xl);
    background: color-mix(in srgb, var(--surface-panel) 87%, var(--surface-hero));
    border-block: 1px solid var(--line-soft);
  }

  .not-grid {
    display: grid;
    grid-template-columns: minmax(15rem, 0.75fr) minmax(0, 1.25fr);
    gap: var(--space-2xl);
  }

  .not-grid ul {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-m) var(--space-l);
  }

  .not-grid li {
    position: relative;
    padding-inline-start: var(--space-l);
