---
import BaseLayout from "@layouts/BaseLayout.astro";
import SiteHeader from "@components/SiteHeader.astro";
import HomeHero from "@components/HomeHero.astro";
import HomeThreshold from "@components/HomeThreshold.astro";
import FourCornerstones from "@components/FourCornerstones.astro";
import HistoryPreview from "@components/HistoryPreview.astro";
import LibraryShowcase from "@components/LibraryShowcase.astro";
import ActivitiesFormation from "@components/ActivitiesFormation.astro";
import SiteFooter from "@components/SiteFooter.astro";
---

<BaseLayout
  title="Orden Real de Heredom de Kilwinning | México y el Caribe"
  description="Orden Real de Heredom de Kilwinning — tradición, biblioteca y formación abierta sobre la Masonería Operativa. Capítulo Soberano para México y el Caribe."
>
  <SiteHeader current="/" />

  <main id="contenido">
    <HomeHero />
    <HomeThreshold />

    <section id="puertas" class="doors container" aria-labelledby="doors-title">
      <header class="doors-head">
        <p class="overline">Recorrer el portal</p>
        <h2 id="doors-title">Tres puertas de entrada</h2>
      </header>

      <div class="doors-grid">
        <article class="door door-orden">
          <p class="door-number" aria-hidden="true">I</p>
          <h3>La Orden</h3>
          <p>
            Filiación, fundamentos y Antiguos Deberes de la Orden Real de Heredom
            de Kilwinning.
          </p>
          <a class="link-text" href="/la-orden/">Conocer la Orden</a>
        </article>

        <article class="door door-biblioteca">
          <p class="door-number" aria-hidden="true">II</p>
          <h3>La Biblioteca</h3>
          <p>
            Documentos públicos acompañados por una ficha que declara su procedencia
            y naturaleza editorial.
          </p>
          <a class="link-text" href="/biblioteca/">Entrar a la Biblioteca</a>
        </article>

        <article class="door door-formacion">
          <p class="door-number" aria-hidden="true">III</p>
          <h3>Formación</h3>
          <p>
            Cursos, conferencias y materiales de estudio conservados en un archivo
            abierto.
          </p>
          <a class="link-secondary" href="/#actividades">Ver actividades y formación</a>
        </article>
      </div>
    </section>

    <FourCornerstones />
    <HistoryPreview />
    <LibraryShowcase />
    <ActivitiesFormation />
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .doors {
    padding-block: var(--space-2xl);
  }

  .doors-head {
    margin-block-end: var(--space-l);
  }

  .doors-head .overline {
    color: var(--text-accent-strong);
  }

  .doors-head h2 {
    font-size: var(--step-3);
    margin-block-start: var(--space-xs);
  }

  .doors-grid {
    display: grid;
    gap: var(--space-2xl);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .door {
    align-items: flex-start;
    border-top: 2px solid;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding-block-start: var(--space-m);
  }

  .door-orden {
    border-color: var(--surface-accent);
  }

  .door-biblioteca {
    border-color: var(--accent-bronze);
  }

  .door-formacion {
    border-color: var(--accent-heraldic);
  }

  .door-number {
    color: var(--text-faint);
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1;
  }

  .door-orden .door-number {
    color: var(--text-accent-strong);
  }

  .door-biblioteca .door-number {
    color: var(--nature-historia-fg);
  }

  .door-formacion .door-number {
    color: var(--text-heraldic);
  }

  .door h3 {
    font-size: var(--step-2);
  }

  .door > p:not(.door-number) {
    color: var(--text-muted);
    flex-grow: 1;
    font-size: var(--step--1);
    line-height: 1.6;
  }

  @media (max-width: 899px) {
    .doors-grid {
      gap: var(--space-xl);
      grid-template-columns: 1fr;
      max-width: 34rem;
    }
  }
</style>
