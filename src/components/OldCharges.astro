---
/**
 * Síntesis pública de la Antigua Constitución de 1607.
 * Imagen: Woman teaching geometry, British Library Burney 275, f. 293r,
 * ca. 1309–1316. Dominio público. Original conservado en recursos-originales/.
 */

import InstitutionalDocument from "./InstitutionalDocument.astro";
import { inigoJonesBlocks } from "../data/institutionalDocuments";
---

<section class="old-charges" aria-labelledby="old-charges-title">
  <div class="old-charges__wrap">
    <div class="old-charges__copy">
      <p class="overline old-charges__eyebrow">Los Antiguos Deberes · 1607</p>
      <h2 id="old-charges-title">La Geometría como ciencia del Oficio</h2>

      <blockquote>
        <p>«La Masonería es un digno Oficio y una curiosa Ciencia.»</p>
      </blockquote>

      <div class="old-charges__prose prose">
        <p>
          La Antigua Constitución que lleva la fecha de 1607 presenta la Masonería como
          una de las ciencias liberales y reconoce en la Geometría su fundamento: medir,
          ordenar y dar forma. Su relato tradicional enlaza la preservación de las artes,
          el conocimiento de los antiguos constructores y la edificación del Templo de
          Salomón para mostrar que el Oficio se transmite como conocimiento vivo.
        </p>
        <p>
          Pero ninguna ciencia basta sin deber. El texto exige fidelidad, discreción,
          fraternidad, competencia en el trabajo, paga justa, respeto a los maestros y
          responsabilidad hasta concluir la obra. En los Antiguos Deberes, construir no
          significa únicamente levantar piedra: significa gobernarse a sí mismo conforme
          a medida, verdad y rectitud.
        </p>
      </div>

      <p class="old-charges__inscription">Geometría · Oficio · Deber</p>
    </div>

    <figure class="old-charges__figure">
      <div class="old-charges__plate">
        <img
          src="/images/geometry-personification.webp"
          alt="Personificación medieval de la Geometría utilizando compás y escuadra ante un grupo de estudiantes"
          width="1000"
          height="1105"
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption>
        Personificación de la Geometría. <cite>Elementos de Euclides</cite>, ca.
        1309–1316. British Library. Dominio público.
      </figcaption>
    </figure>
  </div>

  <div class="old-charges__document">
    <InstitutionalDocument
      variant="jones"
      blocks={inigoJonesBlocks}
      closedLabel="Leer el Manuscrito Iñigo Jones"
      openLabel="Cerrar el manuscrito"
      eyebrow="Los Antiguos Deberes · Manuscrito Iñigo Jones"
      title="La Antigua Constitución de los Libres y Aceptados Masones"
      sourceLine="Año 1607"
      pageCount={13}
      pdfHref="/documentos/manuscrito-inigo-jones-1607.pdf"
    />
  </div>
</section>

<style>
  .old-charges {
    padding-block: clamp(var(--space-2xl), 8vw, var(--space-3xl));
    background: var(--surface-panel-soft);
  }

  .old-charges__wrap {
    display: grid;
    width: min(100% - (2 * var(--gutter)), var(--width-content));
    margin-inline: auto;
    gap: clamp(var(--space-xl), 7vw, var(--space-3xl));
  }

  .old-charges__document {
    width: min(100% - (2 * var(--gutter)), var(--width-content));
    margin-inline: auto;
  }

  .old-charges__copy {
    max-width: var(--width-prose);
  }

  .old-charges__eyebrow {
    margin-block: 0 var(--space-s);
    color: var(--text-heraldic);
  }

  h2 {
    max-width: 19ch;
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 600;
    line-height: var(--leading-tight);
    text-wrap: balance;
  }

  blockquote {
    margin: var(--space-l) 0;
    padding: var(--space-m) 0 var(--space-m) var(--space-l);
    border-inline-start: 1px solid var(--line-bronze);
  }

  blockquote p {
    max-width: 30ch;
    margin: 0;
    color: var(--text-accent-strong);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-style: italic;
    font-weight: 500;
    line-height: var(--leading-heading);
  }

  .old-charges__prose {
    max-width: 65ch;
  }

  .old-charges__prose p + p {
    margin-top: var(--space-m);
  }

  .old-charges__inscription {
    margin: var(--space-l) 0 0;
    padding-top: var(--space-m);
    border-top: 1px solid var(--line-heraldic);
    color: var(--text-heraldic);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 650;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .old-charges__figure {
    width: min(100%, 27rem);
    margin: 0 auto;
    align-self: center;
  }

  .old-charges__plate {
    padding: clamp(0.4rem, 1vw, 0.65rem);
    border: 1px solid var(--line-bronze);
    background: var(--surface-page);
    box-shadow: var(--shadow-card);
  }

  .old-charges__plate img {
    display: block;
    width: 100%;
    height: auto;
    filter: saturate(0.82) sepia(0.06) contrast(1.02);
  }

  figcaption {
    margin-top: var(--space-s);
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  @media (min-width: 64rem) {
    .old-charges__wrap {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-areas: "image copy";
      align-items: center;
    }

    .old-charges__copy {
      grid-area: copy;
    }

    .old-charges__figure {
      grid-area: image;
      justify-self: start;
    }
  }
</style>
