---
/**
 * Hero de la Orden. Composición solemne, eje vertical, geometría
 * simbólica de fondo dibujada en SVG (círculos concéntricos y ejes).
 */
interface Props {
  overline?: string;
  title: string;
  lede?: string;
}

const { overline, title, lede } = Astro.props;
---

<section class="hero">
  <svg class="hero-geometry" viewBox="0 0 600 600" aria-hidden="true" fill="none">
    <circle cx="300" cy="300" r="290" stroke="var(--line-soft)" stroke-width="1" />
    <circle cx="300" cy="300" r="210" stroke="var(--line-soft)" stroke-width="1" />
    <circle cx="300" cy="300" r="130" stroke="rgba(155, 117, 66, 0.25)" stroke-width="1" />
    <line x1="300" y1="0" x2="300" y2="600" stroke="var(--line-soft)" stroke-width="1" />
    <line x1="0" y1="300" x2="600" y2="300" stroke="var(--line-soft)" stroke-width="1" />
    <rect
      x="196.5"
      y="196.5"
      width="207"
      height="207"
      stroke="rgba(134, 31, 44, 0.14)"
      stroke-width="1"
      transform="rotate(45 300 300)"
    />
  </svg>

  <div class="hero-content">
    {overline && <p class="overline hero-overline">{overline}</p>}
    <h1 class="hero-title">{title}</h1>
    {lede && <p class="hero-lede">{lede}</p>}
    <div class="hero-actions">
      <slot name="actions" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--surface-panel);
    border-bottom: 1px solid var(--line-soft);
    padding-block: clamp(var(--space-2xl), 12vw, var(--space-3xl));
  }

  .hero-geometry {
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(420px, 80vmin, 720px);
    height: auto;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    width: min(100% - 2 * var(--gutter), 46rem);
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-m);
  }

  .hero-overline {
    color: var(--text-accent-strong);
  }

  .hero-title {
    font-weight: 500;
  }

  .hero-lede {
    font-size: var(--step-1);
    color: var(--text-muted);
    line-height: 1.55;
    max-width: 36rem;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-m);
    flex-wrap: wrap;
    justify-content: center;
    margin-block-start: var(--space-s);
  }

  .hero-actions:empty {
    display: none;
  }
</style>
