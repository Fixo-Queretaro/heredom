---
/**
 * Pausa heráldica entre capítulos doctrinales mayores.
 * El símbolo central reutiliza el circumpunto canónico del sistema.
 */
import Circumpunct from "./Circumpunct.astro";
---

<div class="circumpunct-band" aria-hidden="true">
  <div class="circumpunct-band__inner">
    <span class="circumpunct-band__line"></span>
    <Circumpunct size={34} class="circumpunct-band__mark" />
    <span class="circumpunct-band__line"></span>
  </div>
</div>

<style>
  .circumpunct-band {
    display: grid;
    place-items: center;
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    background: transparent;
    color: var(--accent-bronze);
  }

  .circumpunct-band__inner {
    display: flex;
    width: min(100% - (2 * var(--gutter)), var(--width-content));
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 3vw, 2rem);
  }

  .circumpunct-band__line {
    flex: 1 1 0;
    max-width: 12rem;
    height: 1px;
    background: currentColor;
    opacity: 0.62;
  }

  :global(.circumpunct-band__mark) {
    flex: none;
  }
</style>
