---
/**
 * Hero editorial de la home.
 *
 * Une la presentación de la Orden y la identidad de San Juan Evangelista en
 * una sola portada, sin convertir las imágenes en paneles de fondo:
 *   - El Greco es la lámina principal, completa y contenida.
 *   - El escudo funciona como sello secundario dentro del bloque principal.
 *   - La información de la Logia vive en un zócalo borgoña unido a la obra.
 *
 * El contenido aparece primero en el DOM; CSS coloca la lámina a la izquierda
 * únicamente cuando existe anchura suficiente.
 */
---

<section class="home-hero">
  <div class="hero-grid">
    <div class="hero-copy">
      <!-- Firma principal horizontal: título + escudo como sello -->
      <div class="hero-signature">
        <div class="hero-signature-text">
          <h1 class="hero-heading">Orden Real de Heredom de&nbsp;Kilwinning</h1>
          <p class="hero-seat">
            <span class="hero-seat-primary">Capítulo Soberano para México y el Caribe</span>
          </p>
        </div>
        <img
          class="hero-seal"
          src="/images/escudo.png"
          alt="Escudo armorial de la Orden Real de Heredom de Kilwinning"
          width="593"
          height="909"
          decoding="async"
        />
      </div>

      <p class="hero-lede">
        Un espacio público dedicado al conocimiento de la Masonería Operativa, su
        tradición, sus símbolos y el legado de los antiguos constructores.
      </p>

      <div class="hero-actions">
        <a class="btn btn-primary" href="/la-orden/">Conocer la Orden</a>
        <a class="btn btn-secondary" href="/biblioteca/">Explorar la Biblioteca</a>
      </div>

      <!-- Lema de cierre -->
      <p class="hero-motto">Tradición, estudio y memoria viva</p>
    </div>

    <div class="hero-art">
      <figure class="hero-portrait">
        <div class="hero-portrait-frame">
          <img
            src="/images/san-juan-evangelista-el-greco.webp"
            srcset="/images/san-juan-evangelista-el-greco-640.webp 640w, /images/san-juan-evangelista-el-greco.webp 1000w"
            sizes="(max-width: 899px) min(84vw, 320px), (max-width: 1199px) 330px, 368px"
            alt="San Juan Evangelista sosteniendo el cáliz, obra de El Greco"
            width="1000"
            height="1334"
            decoding="async"
            fetchpriority="high"
          />
        </div>
        <figcaption>
          <span class="hero-lodge-name">San Juan Evangelista N.º 1</span>
          <span class="hero-lodge-rank">Augusta y Respetable Logia Madre + Metropolitana</span>
          <span class="hero-art-credit">El Greco, ca. 1605</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .home-hero {
    background:
      linear-gradient(135deg, rgba(23, 35, 61, 0.16), transparent 48%),
      var(--surface-hero);
    border-bottom: 1px solid rgba(244, 239, 226, 0.18);
    color: var(--text-on-inverse);
  }

  .hero-grid {
    width: min(100% - 2 * var(--gutter), var(--width-content));
    margin-inline: auto;
    display: grid;
    grid-template-areas: "art copy";
    grid-template-columns: minmax(18rem, 0.82fr) minmax(0, 1.18fr);
    align-items: center;
    gap: clamp(3.5rem, 7vw, 7.5rem);
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
  }

  .hero-copy {
    grid-area: copy;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-m);
    max-width: 36rem;
    min-width: 0;
  }

  /* Firma horizontal: H1 + escudo compartiendo la zona del título */
  .hero-signature {
    display: flex;
    align-items: flex-start;
    gap: clamp(var(--space-l), 3vw, var(--space-xl));
    width: 100%;
  }

  .hero-signature-text {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .hero-seal {
    flex: 0 0 auto;
    width: clamp(5.5rem, 8vw, 7.25rem);
    height: auto;
    margin-block-start: 0.35rem; /* alineación óptica con el H1 */
    filter: drop-shadow(0 4px 12px rgba(7, 20, 17, 0.34));
    transform-origin: 50% 48%;
  }

  /* Respiración heráldica: apenas 1.4 % de escala en un ciclo lento. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-seal {
      animation: seal-breath 7.5s ease-in-out infinite;
    }
  }

  @keyframes seal-breath {
    0%,
    100% {
      transform: scale(1);
    }

    50% {
      transform: scale(1.014);
    }
  }

  .hero-heading {
    color: var(--text-on-inverse);
    font-weight: 500;
    font-size: clamp(2.35rem, 1.6rem + 2.8vw, 3.75rem);
    line-height: 1.08;
  }

  /* Lema de cierre */
  .hero-motto {
    margin-block-start: var(--space-s);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1rem + 0.9vw, 1.55rem);
    font-weight: 500;
    font-style: italic;
    line-height: 1.3;
    color: rgba(244, 239, 226, 0.92);
  }

  .hero-lede {
    max-width: 33rem;
    font-size: var(--step-1);
    line-height: 1.55;
    color: rgba(244, 239, 226, 0.78);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    margin-block-start: var(--space-s);
  }

  .hero-seat {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
    max-width: 31rem;
    padding-inline-start: var(--space-m);
    border-inline-start: 1px solid rgba(155, 117, 66, 0.82);
  }

  .hero-seat-primary {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-on-inverse);
  }

  .hero-actions .btn-primary {
    background: var(--text-on-inverse);
    color: var(--surface-hero);
    box-shadow: 0 5px 18px -10px rgba(0, 0, 0, 0.62);
  }

  .hero-actions .btn-primary:hover {
    background: #fffdf5;
    color: #102a24;
  }

  .hero-actions .btn-secondary {
    color: var(--text-on-inverse);
    border-color: rgba(244, 239, 226, 0.48);
  }

  .hero-actions .btn-secondary:hover {
    color: #fffdf5;
    border-color: rgba(255, 253, 245, 0.9);
    background: rgba(255, 253, 245, 0.08);
  }

  .home-hero :focus-visible {
    outline-color: var(--accent-bronze);
  }

  .hero-art {
    grid-area: art;
    justify-self: end;
    width: min(100%, 23rem);
  }

  .hero-portrait {
    position: relative;
    isolation: isolate;
    margin: 0;
    box-shadow: var(--shadow-card);
  }

  /* Margen cálido y halo difuso. La obra permanece nítida: solo se
     suaviza el contorno exterior del marco. */
  .hero-portrait-frame {
    position: relative;
    isolation: isolate;
    padding: clamp(0.35rem, 0.7vw, 0.5rem);
    border: 1px solid var(--accent-bronze);
    border-bottom: 0;
    background: rgba(255, 253, 245, 0.78);
    background: color-mix(in srgb, var(--surface-page) 78%, transparent);
  }

  .hero-portrait-frame::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -0.55rem;
    background: linear-gradient(
      135deg,
      rgba(155, 117, 66, 0.2),
      rgba(89, 21, 29, 0.1)
    );
    filter: blur(0.7rem);
    opacity: 0.58;
    pointer-events: none;
  }

  .hero-portrait-frame > img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-portrait figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 1rem 1.2rem 1.1rem;
    border: 1px solid var(--accent-bronze);
    border-top: 1px solid rgba(253, 246, 236, 0.24);
    background: var(--surface-accent);
    color: var(--text-on-accent);
  }

  .hero-lodge-name {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.1rem + 0.7vw, 1.7rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .hero-lodge-rank {
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-style: italic;
    line-height: 1.4;
    color: rgba(253, 246, 236, 0.86);
  }

  .hero-art-credit {
    margin-block-start: 0.35rem;
    font-family: var(--font-ui);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: rgba(253, 246, 236, 0.66);
  }

  @media (min-width: 1024px) {
    .home-hero {
      min-height: min(84svh, 58rem);
      display: flex;
      align-items: center;
    }
  }

  /* En anchuras medias y móvil la firma se apila: el texto usa todo el
     ancho y el escudo pasa después del bloque principal, a la derecha */
  @media (max-width: 1023px) {
    .hero-signature {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-m);
    }

    .hero-seal {
      align-self: flex-end;
      margin-block-start: 0;
    }
  }

  @media (max-width: 1023px) and (min-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(17rem, 0.75fr) minmax(0, 1.25fr);
      gap: clamp(2.5rem, 5vw, 4rem);
    }

    .hero-art {
      width: min(100%, 20.5rem);
    }

    .hero-heading {
      font-size: clamp(2.35rem, 4.7vw, 3.15rem);
    }
  }

  @media (max-width: 899px) {
    .hero-grid {
      grid-template-areas:
        "copy"
        "art";
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(3rem, 8vw, 4.5rem);
    }

    .hero-copy {
      max-width: 38rem;
    }

    .hero-art {
      justify-self: center;
      width: min(84vw, 20rem);
    }
  }

  @media (max-width: 479px) {
    .hero-grid {
      padding-block: var(--space-xl) var(--space-2xl);
    }

    .hero-seal {
      width: 5.75rem;
    }

    .hero-actions {
      width: 100%;
    }

    .hero-actions .btn {
      width: 100%;
      justify-content: center;
    }

    .hero-art {
      width: min(86vw, 19rem);
    }

    .hero-portrait figcaption {
      padding: 0.9rem 1rem 1rem;
    }
  }
</style>
