---
import Circumpunct from "@components/Circumpunct.astro";
import LibraryCard from "@components/LibraryCard.astro";
import {
  featuredLibraryDocuments,
  getLibraryDocument,
  getLibraryResourcePath,
  libraryDocuments,
} from "../data/library";

const lead = getLibraryDocument("escuadrando-historia-oficial-masoneria-moderna");
const related = getLibraryDocument("lado-oscuro-james-anderson");
const companions = featuredLibraryDocuments.filter((document) => document.slug !== lead?.slug);
const totalPages = libraryDocuments.reduce((total, document) => total + (document.pages ?? 0), 0);

if (!lead || !related) {
  throw new Error("No se encontró la selección editorial de la Biblioteca.");
}
---

<section class="library-showcase" aria-labelledby="library-showcase-title">
  <div class="container showcase-inner">
    <header class="showcase-head">
      <div>
        <p class="overline showcase-eyebrow">Biblioteca Heredom</p>
        <h2 id="library-showcase-title">Textos para entrar en materia</h2>
      </div>
      <p class="showcase-intro">
        {libraryDocuments.length} recursos de acceso público, ordenados por tema y acompañados de una
        ficha editorial para distinguir tradición, estudio y controversia.
      </p>
    </header>

    <div class="showcase-grid">
      <article class="lead-document">
        <div class="lead-seal" aria-hidden="true">
          <Circumpunct size={48} />
        </div>
        <p class="lead-label">Expediente principal · Controversia doctrinal</p>
        <h3><a href={`/biblioteca/${lead.slug}/`}>{lead.title}</a></h3>
        <p class="lead-summary">{lead.summary}</p>
        <dl class="lead-facts">
          <div><dt>Responsable</dt><dd>{lead.responsible}</dd></div>
          <div><dt>Extensión</dt><dd>{lead.pages ?? 0} páginas</dd></div>
        </dl>
        <div class="lead-actions">
          <a class="btn btn-library" href={`/biblioteca/${lead.slug}/`}>Leer la ficha</a>
          <a class="lead-pdf" href={getLibraryResourcePath(lead)} target="_blank" rel="noopener">
            Abrir PDF <span class="sr-only">en una pestaña nueva</span>
          </a>
        </div>
        <p class="lead-related">
          Lectura relacionada:
          <a href={`/biblioteca/${related.slug}/`}>{related.shortTitle ?? related.title}</a>
        </p>
      </article>

      <div class="companion-grid">
        {companions.map((document) => (
          <LibraryCard document={document} compact />
        ))}
      </div>
    </div>

    <footer class="showcase-foot">
      <p>La colección completa reúne {libraryDocuments.length} recursos y {totalPages} páginas en PDF.</p>
      <a class="btn btn-secondary" href="/biblioteca/">Consultar los {libraryDocuments.length} recursos</a>
    </footer>
  </div>
</section>

<style>
  .library-showcase {
    padding-block: var(--space-2xl);
    background: var(--surface-panel-soft);
    border-block: 1px solid var(--line-soft);
  }

  .showcase-head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-xl);
    align-items: end;
    margin-block-end: var(--space-xl);
  }

  .showcase-eyebrow {
    color: var(--text-accent-strong);
  }

  .showcase-head h2 {
    font-size: var(--step-4);
    margin-block-start: var(--space-xs);
  }

  .showcase-intro {
    color: var(--text-muted);
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(var(--space-l), 5vw, var(--space-2xl));
    align-items: start;
  }

  .lead-document {
    position: relative;
    min-height: 100%;
    padding: clamp(var(--space-l), 5vw, var(--space-xl));
    background: var(--surface-inverse);
    color: var(--text-on-inverse);
    border-top: 1px solid var(--line-bronze);
    overflow: hidden;
  }

  .lead-document::after {
    content: "";
    position: absolute;
    inset: var(--space-s);
    border: 1px solid rgba(155, 117, 66, 0.28);
    pointer-events: none;
  }

  .lead-seal {
    color: var(--accent-bronze);
    margin-block-end: var(--space-l);
  }

  .lead-label {
    position: relative;
    z-index: 1;
    font-family: var(--font-ui);
    font-size: 0.68rem;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: rgba(244, 239, 226, 0.68);
  }

  .lead-document h3 {
    position: relative;
    z-index: 1;
    font-size: clamp(2rem, 1.55rem + 1.7vw, 3rem);
    margin-block-start: var(--space-s);
  }

  .lead-document h3 a {
    color: var(--text-on-inverse);
    text-decoration: none;
  }

  .lead-document h3 a:hover {
    color: var(--text-on-inverse);
    text-decoration: underline;
    text-decoration-color: var(--accent-bronze);
  }

  .lead-summary {
    position: relative;
    z-index: 1;
    margin-block-start: var(--space-m);
    color: rgba(244, 239, 226, 0.78);
  }

  .lead-facts {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(7rem, 1fr);
    gap: var(--space-m);
    margin-block: var(--space-l);
    padding-block: var(--space-m);
    border-block: 1px solid rgba(244, 239, 226, 0.18);
  }

  .lead-facts dt {
    font-family: var(--font-ui);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(244, 239, 226, 0.5);
  }

  .lead-facts dd {
    margin: var(--space-2xs) 0 0;
    font-size: var(--step--1);
  }

  .lead-actions {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    align-items: center;
  }

  .btn-library {
    background: var(--surface-panel);
    color: var(--text-primary);
  }

  .btn-library:hover {
    background: var(--surface-page);
    color: var(--text-primary);
  }

  .lead-pdf,
  .lead-related a {
    color: var(--text-on-inverse);
    text-decoration-color: rgba(155, 117, 66, 0.8);
  }

  .lead-pdf {
    font-family: var(--font-ui);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lead-related {
    position: relative;
    z-index: 2;
    margin-block-start: var(--space-l);
    font-size: var(--step--1);
    color: rgba(244, 239, 226, 0.6);
  }

  .companion-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-l);
  }

  .showcase-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-l);
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-l);
    border-top: 1px solid var(--line-bronze);
  }

  .showcase-foot p {
    color: var(--text-muted);
    font-style: italic;
  }

  @media (max-width: 1023px) {
    .showcase-head,
    .showcase-grid {
      grid-template-columns: 1fr;
    }

    .companion-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .companion-grid {
      grid-template-columns: 1fr;
      max-width: 24rem;
    }

    .showcase-foot {
      align-items: flex-start;
      flex-direction: column;
    }

    .lead-facts {
      grid-template-columns: 1fr;
    }
  }
</style>
