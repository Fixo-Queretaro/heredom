---
/**
 * Cruz maltesa de ocho puntas. Construida con cuatro brazos cóncavos
 * idénticos y rotados; hereda el color del contexto mediante currentColor.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 40, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 64 64"
  width={size}
  height={size}
  aria-hidden="true"
  fill="currentColor"
>
  <path d="M32 31 18 10Q25 13 32 20 39 13 46 10Z"></path>
  <path d="M32 31 18 10Q25 13 32 20 39 13 46 10Z" transform="rotate(90 32 32)"></path>
  <path d="M32 31 18 10Q25 13 32 20 39 13 46 10Z" transform="rotate(180 32 32)"></path>
  <path d="M32 31 18 10Q25 13 32 20 39 13 46 10Z" transform="rotate(270 32 32)"></path>
</svg>
