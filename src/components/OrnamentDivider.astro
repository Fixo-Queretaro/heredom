---
/**
 * Separador ornamental: eje horizontal fino con circumpunto central
 * auténtico (un círculo, un punto). Corregido en la ronda 3: el motivo
 * anterior de anillos concéntricos con puntos cardinales leía como "diana".
 */
import Circumpunct from "./Circumpunct.astro";
---

<div class="ornament" role="separator" aria-hidden="true">
  <span class="ornament-line"></span>
  <Circumpunct size={30} class="ornament-mark" />
  <span class="ornament-line"></span>
</div>

<style>
  .ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-m);
    margin-block: var(--space-xl);
    color: var(--accent-bronze);
  }

  .ornament-line {
    display: block;
    width: min(128px, 28vw);
    height: 1px;
    background: var(--line-strong);
  }

  .ornament :global(.ornament-mark) {
    flex-shrink: 0;
  }
</style>
