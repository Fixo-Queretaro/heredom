---
import MonochromeFlag from "@components/MonochromeFlag.astro";

const nav = [
  { href: "/", label: "Inicio" },
  { href: "/entrar-a-la-masoneria/", label: "Cómo acercarse" },
  { href: "/biblioteca/", label: "Biblioteca" },
  { href: "/#actividades", label: "Sympósion y Peritextos" },
  { href: "/#memoria-mexico", label: "Memoria tradicional" },
];

const social = [
  {
    href: "https://www.tiktok.com/@hrdm.klwnnng.mx",
    label: "TikTok",
    icon: "tiktok",
  },
  {
    href: "https://www.facebook.com/profile.php?id=100095300929470",
    label: "Facebook",
    icon: "facebook",
  },
  {
    href: "https://www.youtube.com/@hrdm-klwnnng.m.x",
    label: "YouTube",
    icon: "youtube",
  },
];

const worldOrders = [
  {
    country: "Argentina",
    name: "Logia Madre",
    flag: "argentina" as const,
    href: "https://hrdm.com.ar/index.html",
    mother: true,
  },
  {
    country: "Brasil",
    flag: "brasil" as const,
    href: "https://hrdmoficial.com.br/",
  },
  {
    country: "Chile",
    flag: "chile" as const,
    href: "https://masoneriaheredom.blogspot.com/",
  },
  {
    country: "España",
    flag: "espana" as const,
    href: "https://www.heredom.es/",
  },
  {
    country: "Paraguay",
    flag: "paraguay" as const,
    href: "https://masoneriaheredomparaguay.org/",
  },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <img
        class="footer-shield"
        src="/images/escudo.png"
        alt=""
        width="593"
        height="909"
        loading="lazy"
      />
      <div>
        <p class="footer-name">Orden Real de Heredom de Kilwinning</p>
        <p class="footer-lines">
          San Juan Evangelista N.º 1<br />
          Capítulo Soberano para México y el Caribe
        </p>
      </div>
    </div>

    <nav class="footer-nav" aria-label="Navegación del pie de página">
      <p class="footer-heading">Recorrer el portal</p>
      <ul role="list">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer-social">
      <p class="footer-heading">Presencia pública</p>
      <ul role="list">
        {
          social.map((item) => (
            <li>
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={item.label + " de la Orden Real de Heredom de Kilwinning (abre en una pestaña nueva)"}
              >
                {item.icon === "tiktok" ? (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      d="M14.4 3.4c.4 2.2 1.7 3.6 3.8 4v3.1a8.2 8.2 0 0 1-3.8-1.1v6.1a5.6 5.6 0 1 1-4.8-5.6v3.2a2.5 2.5 0 1 0 1.7 2.4V3.4h3.1Z"
                      fill="currentColor"
                    />
                  </svg>
                ) : item.icon === "youtube" ? (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      d="M21.6 7.2a2.8 2.8 0 0 0-2-2C17.9 4.8 12 4.8 12 4.8s-5.9 0-7.6.4a2.8 2.8 0 0 0-2 2A29 29 0 0 0 2 12a29 29 0 0 0 .4 4.8 2.8 2.8 0 0 0 2 2c1.7.4 7.6.4 7.6.4s5.9 0 7.6-.4a2.8 2.8 0 0 0 2-2A29 29 0 0 0 22 12a29 29 0 0 0-.4-4.8ZM10 15.2V8.8l5.5 3.2-5.5 3.2Z"
                      fill="currentColor"
                    />
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      d="M13.7 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.6-1.5H17V4a22 22 0 0 0-2.5-.1c-2.5 0-4.2 1.5-4.2 4.3V10H7.5v3h2.8v8h3.4Z"
                      fill="currentColor"
                    />
                  </svg>
                )}
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <aside class="featured-publication" aria-labelledby="featured-publication-title">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 4.5c2.7-.8 5-.5 7 .8v14.2c-2-1.3-4.3-1.6-7-.8V4.5Zm14 0c-2.7-.8-5-.5-7 .8v14.2c2-1.3 4.3-1.6 7-.8V4.5Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
        </svg>
        <div>
          <p class="publication-kicker">Publicación destacada</p>
          <p id="featured-publication-title" class="publication-title">La Francmasonería Tradicional y Operativa en el Siglo XXI</p>
          <a
            href="https://www.mercadolibre.com.mx/up/MLMU3748329834?matt_tool=17030900&amp;pdp_filters=item_id:MLM4689814522&amp;ua=ZgoJzBJmT-iaSO_l3ETmnohis5OzoTSjetjpOyCjd3Z0DXNJ#origin=share&amp;sid=share&amp;wid=MLM4689814522&amp;action=whatsapp"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Consultar el libro La Francmasonería Tradicional y Operativa en el Siglo XXI (abre en una pestaña nueva)"
          >Consultar el libro ↗</a>
        </div>
      </aside>
    </div>

    <figure class="footer-cup">
      <div class="footer-cup-frame">
        <img
          src="/images/san-juan-evangelista-el-greco-640.webp"
          alt="Cáliz con el dragón en San Juan Evangelista, obra de El Greco"
          width="640"
          height="854"
          loading="lazy"
        />
      </div>
    </figure>
  </div>

  <section class="footer-world" aria-labelledby="footer-world-title">
    <div class="footer-world-inner">
      <h2 id="footer-world-title" class="footer-world-title">Presencia internacional</h2>

      <ul class="footer-world-list" role="list">
        {
          worldOrders.map((order) => (
            <li class:list={{ "is-mother": order.mother }}>
              <a
                href={order.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${order.country}${order.name ? `, ${order.name}` : ""} (abre en una pestaña nueva)`}
              >
                <MonochromeFlag country={order.flag} />
                <span class="world-copy">
                  <span class="world-country">{order.country}</span>
                  {order.name && <span class="world-name">{order.name}</span>}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="footer-lower">
    <div class="footer-lower-inner">
      <p class="footer-editorial">
        Este portal distingue entre tradición, doctrina, estudio e historia documentada.
      </p>

      <aside class="approach-channel" aria-labelledby="approach-title">
        <p id="approach-title" class="approach-title">Canal de acercamiento</p>
        <p>
          Conoce primero qué significa ser masón, los requisitos generales y cómo se valora cada candidatura.
        </p>
        <a class="approach-guide" href="/entrar-a-la-masoneria/">Leer la orientación</a>
        <a
          class="approach-link"
          href="https://docs.google.com/forms/d/e/1FAIpQLSfgiDWhsQwmMrca4y43sPNu45gwji_t-iZyJqYz6jEF2abEfA/viewform?usp=dialog"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Iniciar acercamiento mediante el formulario de la Orden (abre en una pestaña nueva)"
        >Iniciar acercamiento ↗</a>
      </aside>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --footer-surface: var(--surface-hero);
    background: var(--footer-surface);
    border-top: 1px solid var(--line-bronze);
    color: var(--text-on-accent);
    margin-block-start: 0;
    position: relative;
    transition: background-color var(--transition-quiet);
  }

  .footer-inner,
  .footer-world-inner,
  .footer-lower-inner {
    width: min(100% - 2 * var(--gutter), var(--width-content));
    margin-inline: auto;
  }

  .footer-inner {
    display: grid;
    grid-template-columns:
      minmax(19rem, 2.2fr)
      minmax(10rem, 1fr)
      minmax(9rem, 0.8fr)
      minmax(5.25rem, 0.45fr);
    align-items: start;
    gap: var(--space-xl);
    padding-block: var(--space-xl);
  }

  .footer-brand {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    align-items: start;
    gap: var(--space-m);
  }

  .footer-shield {
    width: 3.5rem;
    height: auto;
    filter: sepia(0.08) brightness(1.08);
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: var(--leading-heading);
    max-width: 19rem;
  }

  .footer-lines {
    color: color-mix(in srgb, var(--text-on-accent) 76%, transparent);
    font-size: var(--step--1);
    font-style: italic;
    line-height: 1.55;
    margin-block-start: var(--space-xs);
  }

  .footer-heading {
    color: var(--text-on-accent);
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    line-height: 1.4;
    margin-block-end: var(--space-m);
    text-transform: uppercase;
  }

  .footer-nav ul,
  .footer-social ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-nav a,
  .footer-social a {
    color: color-mix(in srgb, var(--text-on-accent) 78%, transparent);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    text-decoration: none;
  }

  .footer-nav a:hover,
  .footer-social a:hover {
    color: var(--text-on-accent);
    text-decoration: underline;
    text-decoration-color: var(--line-bronze);
    text-underline-offset: 0.25em;
  }

  .footer-nav a:focus-visible,
  .footer-social a:focus-visible {
    outline-color: var(--line-bronze);
  }

  .footer-social a {
    align-items: center;
    display: inline-flex;
    gap: var(--space-xs);
  }

  .footer-social svg {
    flex: 0 0 auto;
    height: 1rem;
    width: 1rem;
  }

  .featured-publication {
    border-top: 1px solid color-mix(in srgb, var(--line-bronze) 64%, transparent);
    display: grid;
    gap: var(--space-xs);
    grid-template-columns: 1.15rem minmax(0, 1fr);
    margin-block-start: var(--space-m);
    padding-block-start: var(--space-m);
  }

  .featured-publication > svg {
    color: var(--line-bronze);
    height: 1.15rem;
    margin-block-start: 0.15rem;
    width: 1.15rem;
  }

  .featured-publication .publication-kicker {
    color: color-mix(in srgb, var(--text-on-accent) 58%, transparent);
    font-family: var(--font-ui);
    font-size: 0.59rem;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .featured-publication .publication-title {
    color: var(--text-on-accent);
    font-family: var(--font-display);
    font-size: 0.92rem;
    line-height: 1.3;
    margin-block-start: var(--space-2xs);
  }

  .featured-publication a {
    display: inline-block;
    font-size: 0.63rem;
    margin-block-start: var(--space-xs);
    text-transform: uppercase;
  }

  .footer-cup {
    justify-self: end;
    width: 5.25rem;
  }

  .footer-cup-frame {
    aspect-ratio: 0.58;
    background: var(--surface-accent);
    border: 1px solid var(--line-bronze);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--surface-header) 78%, black),
      0 0.3rem 0.8rem rgba(0, 0, 0, 0.18);
    overflow: hidden;
    padding: 3px;
    position: relative;
  }

  .footer-cup-frame::before {
    border: 1px solid var(--surface-accent);
    content: "";
    inset: 2px;
    pointer-events: none;
    position: absolute;
    z-index: 2;
  }

  .footer-cup-frame::after {
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--line-bronze) 72%, transparent),
      inset 0 0 0.65rem 0.2rem color-mix(in srgb, var(--surface-header) 68%, transparent);
    content: "";
    inset: 4px;
    pointer-events: none;
    position: absolute;
    z-index: 1;
  }

  .footer-cup img {
    filter: sepia(0.12) saturate(0.82) contrast(0.94);
    inset-block-start: -114%;
    inset-inline-start: -0.1rem;
    max-width: none;
    position: absolute;
    width: 280%;
  }

  .footer-world {
    border-top: 1px solid color-mix(in srgb, var(--line-bronze) 70%, transparent);
  }

  .footer-world-inner {
    padding-block: var(--space-m) var(--space-l);
  }

  .footer-world-title {
    color: color-mix(in srgb, var(--text-on-accent) 70%, transparent);
    font-family: var(--font-ui);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    line-height: 1.4;
    text-transform: uppercase;
  }

  .footer-world-list {
    display: grid;
    gap: var(--space-s) var(--space-l);
    grid-template-columns: repeat(5, minmax(0, 1fr));
    list-style: none;
    margin: var(--space-m) 0 0;
    padding: 0;
  }

  .footer-world-list a {
    align-items: center;
    color: color-mix(in srgb, var(--text-on-accent) 82%, transparent);
    display: inline-flex;
    gap: var(--space-xs);
    text-decoration: none;
  }

  .footer-world-list a:hover {
    color: var(--text-on-accent);
  }

  .footer-world-list a:focus-visible {
    outline-color: var(--line-bronze);
  }

  .world-copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .world-country {
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.35;
  }

  .world-name {
    color: color-mix(in srgb, var(--text-on-accent) 66%, transparent);
    font-family: var(--font-ui);
    font-size: 0.6rem;
    font-style: italic;
    line-height: 1.45;
  }

  .footer-lower {
    border-top: 1px solid color-mix(in srgb, var(--line-bronze) 70%, transparent);
  }

  .footer-lower-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(17rem, 0.65fr);
    gap: var(--space-xl);
    align-items: center;
    padding-block: var(--space-l);
  }

  .footer-editorial {
    color: color-mix(in srgb, var(--text-on-accent) 72%, transparent);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.025em;
    line-height: 1.6;
  }

  .approach-channel {
    border-left: 1px solid var(--line-bronze);
    padding-inline-start: var(--space-m);
  }

  .approach-channel p {
    color: color-mix(in srgb, var(--text-on-accent) 74%, transparent);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .approach-channel .approach-title {
    color: var(--text-on-accent);
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.2;
    margin-block-end: var(--space-2xs);
  }

  .approach-channel .approach-link {
    color: var(--text-on-accent);
    display: inline-block;
    font-family: var(--font-ui);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    margin-block-start: var(--space-s);
    text-decoration-color: var(--line-bronze);
    text-transform: uppercase;
  }

  .approach-channel .approach-guide {
    display: inline-block;
    margin-block-start: var(--space-s);
    color: color-mix(in srgb, var(--text-on-accent) 82%, transparent);
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }

  @media (max-width: 899px) {
    .footer-inner {
      grid-template-columns: minmax(0, 1.6fr) minmax(9rem, 0.8fr);
    }

    .footer-social {
      grid-column: 1;
    }

    .footer-cup {
      grid-column: 2;
      grid-row: 2;
      justify-self: start;
    }

    .footer-world-inner {
      padding-block-end: var(--space-l);
    }

    .footer-world-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .footer-lower-inner {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
  }

  @media (max-width: 559px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--space-l);
      padding-block: var(--space-l);
    }

    .footer-brand {
      grid-template-columns: 3rem minmax(0, 1fr);
    }

    .footer-shield {
      width: 3rem;
    }

    .footer-social,
    .footer-cup {
      grid-column: 1;
      grid-row: auto;
    }

    .footer-cup {
      justify-self: start;
      width: 4.75rem;
    }

    .footer-world-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-s);
    }

    .footer-lower-inner {
      padding-block: var(--space-m) var(--space-l);
    }
  }
</style>
