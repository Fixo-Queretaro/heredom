---
const nav = [
  { href: "/", label: "Inicio" },
  { href: "/la-orden/", label: "La Orden" },
  { href: "/tradicion-e-historia/", label: "Tradición e historia" },
  { href: "/biblioteca/", label: "Biblioteca" },
  { href: "/#actividades", label: "Actividades y formación" },
];

const social = [
  {
    href: "https://www.tiktok.com/@hrdm.klwnnng.mx",
    label: "TikTok",
    icon: "tiktok",
  },
  {
    href: "https://www.facebook.com/profile.php?id=100095300929470",
    label: "Facebook",
    icon: "facebook",
  },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <img
        class="footer-shield"
        src="/images/escudo.png"
        alt=""
        width="593"
        height="909"
        loading="lazy"
      />
      <div>
        <p class="footer-name">Orden Real de Heredom de Kilwinning</p>
        <p class="footer-lines">
          San Juan Evangelista N.º 1<br />
          Capítulo Soberano para México y el Caribe<br />
          Oriente de la Ciudad de México
        </p>
      </div>
    </div>

    <nav class="footer-nav" aria-label="Navegación del pie de página">
      <p class="footer-heading">Recorrer el portal</p>
      <ul role="list">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer-social">
      <p class="footer-heading">Presencia pública</p>
      <ul role="list">
        {
          social.map((item) => (
            <li>
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={item.label + " de la Orden Real de Heredom de Kilwinning (abre en una pestaña nueva)"}
              >
                {item.icon === "tiktok" ? (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      d="M14.4 3.4c.4 2.2 1.7 3.6 3.8 4v3.1a8.2 8.2 0 0 1-3.8-1.1v6.1a5.6 5.6 0 1 1-4.8-5.6v3.2a2.5 2.5 0 1 0 1.7 2.4V3.4h3.1Z"
                      fill="currentColor"
                    />
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      d="M13.7 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.6-1.5H17V4a22 22 0 0 0-2.5-.1c-2.5 0-4.2 1.5-4.2 4.3V10H7.5v3h2.8v8h3.4Z"
                      fill="currentColor"
                    />
                  </svg>
                )}
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="footer-cup">
      <div class="footer-cup-frame">
        <img
          src="/images/san-juan-evangelista-el-greco-640.webp"
          alt="Cáliz con el dragón en San Juan Evangelista, obra de El Greco"
          width="640"
          height="854"
          loading="lazy"
        />
      </div>
    </figure>
  </div>

  <div class="footer-lower">
    <div class="footer-lower-inner">
      <p class="footer-editorial">
        Este portal distingue entre tradición institucional, doctrina, estudio e
        historia documentada.
      </p>

      <aside id="canal-acercamiento" class="approach-channel" aria-labelledby="approach-title">
        <!-- Pendiente: convertir el título en enlace cuando exista el Google Forms oficial. -->
        <p id="approach-title" class="approach-title">Canal de acercamiento</p>
        <p>
          Espacio reservado para solicitar información sobre una posible incorporación.
        </p>
        <p class="approach-status">Formulario institucional en preparación.</p>
      </aside>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface-accent);
    border-top: 1px solid var(--line-bronze);
    color: var(--text-on-accent);
    margin-block-start: 0;
  }

  .footer-inner,
  .footer-lower-inner {
    width: min(100% - 2 * var(--gutter), var(--width-content));
    margin-inline: auto;
  }

  .footer-inner {
    display: grid;
    grid-template-columns:
      minmax(19rem, 2.2fr)
      minmax(10rem, 1fr)
      minmax(9rem, 0.8fr)
      minmax(5.25rem, 0.45fr);
    align-items: start;
    gap: var(--space-xl);
    padding-block: var(--space-xl);
  }

  .footer-brand {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    align-items: start;
    gap: var(--space-m);
  }

  .footer-shield {
    width: 3.5rem;
    height: auto;
    filter: sepia(0.08) brightness(1.08);
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: var(--leading-heading);
    max-width: 19rem;
  }

  .footer-lines {
    color: color-mix(in srgb, var(--text-on-accent) 76%, transparent);
    font-size: var(--step--1);
    font-style: italic;
    line-height: 1.55;
    margin-block-start: var(--space-xs);
  }

  .footer-heading {
    color: var(--text-on-accent);
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    line-height: 1.4;
    margin-block-end: var(--space-m);
    text-transform: uppercase;
  }

  .footer-nav ul,
  .footer-social ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-nav a,
  .footer-social a {
    color: color-mix(in srgb, var(--text-on-accent) 78%, transparent);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    text-decoration: none;
  }

  .footer-nav a:hover,
  .footer-social a:hover {
    color: var(--text-on-accent);
    text-decoration: underline;
    text-decoration-color: var(--line-bronze);
    text-underline-offset: 0.25em;
  }

  .footer-nav a:focus-visible,
  .footer-social a:focus-visible {
    outline-color: var(--line-bronze);
  }

  .footer-social a {
    align-items: center;
    display: inline-flex;
    gap: var(--space-xs);
  }

  .footer-social svg {
    flex: 0 0 auto;
    height: 1rem;
    width: 1rem;
  }

  .footer-cup {
    justify-self: end;
    width: 5.25rem;
  }

  .footer-cup-frame {
    aspect-ratio: 0.58;
    border: 1px solid var(--line-bronze);
    overflow: hidden;
    position: relative;
  }

  .footer-cup-frame::after {
    box-shadow: inset 0 0 0.75rem 0.28rem var(--surface-accent);
    content: "";
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  .footer-cup img {
    filter: sepia(0.12) saturate(0.82) contrast(0.94);
    inset-block-start: -114%;
    inset-inline-start: -0.1rem;
    max-width: none;
    position: absolute;
    width: 280%;
  }

  .footer-lower {
    border-top: 1px solid color-mix(in srgb, var(--line-bronze) 70%, transparent);
  }

  .footer-lower-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(17rem, 0.65fr);
    gap: var(--space-xl);
    align-items: center;
    padding-block: var(--space-l);
  }

  .footer-editorial {
    color: color-mix(in srgb, var(--text-on-accent) 72%, transparent);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.025em;
    line-height: 1.6;
  }

  .approach-channel {
    border-left: 1px solid var(--line-bronze);
    padding-inline-start: var(--space-m);
  }

  .approach-channel p {
    color: color-mix(in srgb, var(--text-on-accent) 74%, transparent);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .approach-channel .approach-title {
    color: var(--text-on-accent);
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.2;
    margin-block-end: var(--space-2xs);
  }

  .approach-channel .approach-status {
    color: color-mix(in srgb, var(--text-on-accent) 72%, transparent);
    font-size: 0.66rem;
    font-style: italic;
    margin-block-start: var(--space-2xs);
  }

  @media (max-width: 899px) {
    .footer-inner {
      grid-template-columns: minmax(0, 1.6fr) minmax(9rem, 0.8fr);
    }

    .footer-social {
      grid-column: 1;
    }

    .footer-cup {
      grid-column: 2;
      grid-row: 2;
      justify-self: start;
    }

    .footer-lower-inner {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
  }

  @media (max-width: 559px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--space-l);
      padding-block: var(--space-l);
    }

    .footer-brand {
      grid-template-columns: 3rem minmax(0, 1fr);
    }

    .footer-shield {
      width: 3rem;
    }

    .footer-social,
    .footer-cup {
      grid-column: 1;
      grid-row: auto;
    }

    .footer-cup {
      justify-self: start;
      width: 4.75rem;
    }

    .footer-lower-inner {
      padding-block: var(--space-m) var(--space-l);
    }
  }
</style>
