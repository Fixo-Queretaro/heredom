---
/**
 * Circumpunto auténtico: un solo círculo de trazo fino y un único punto
 * central discreto (diámetro ≈ 10 % del círculo). Sin anillos adicionales,
 * sin cruz, sin rayos, sin fondo. Hereda el color del contexto vía
 * `currentColor`; escala limpiamente por ser SVG.
 */
interface Props {
  /** Tamaño de render en px (el viewBox es constante) */
  size?: number;
  class?: string;
}

const { size = 40, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 64 64"
  width={size}
  height={size}
  aria-hidden="true"
>
  <circle cx="32" cy="32" r="20" fill="none" stroke="currentColor" stroke-width="1.25"></circle>
  <circle cx="32" cy="32" r="2" fill="currentColor"></circle>
</svg>
